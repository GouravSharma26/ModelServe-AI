# ModelServe AI — Environment Configuration Example
# Copy this file to .env and adjust variables as needed.

MODELSERVE_ENV=development
MODELSERVE_HOST=0.0.0.0
MODELSERVE_PORT=8000
MODELSERVE_LOG_LEVEL=INFO
MODELSERVE_ARTIFACTS_DIR=artifacts/models
# Leave MODELSERVE_MODEL_VERSION empty to automatically load the latest verified artifact
MODELSERVE_MODEL_VERSION=
MODELSERVE_MAX_PAYLOAD_BYTES=65536

# PostgreSQL database configuration (used in Phase 3+)
POSTGRES_USER=modelserve_user
POSTGRES_PASSWORD=replace_with_secure_password
POSTGRES_DB=modelserve_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://modelserve_user:replace_with_secure_password@localhost:5432/modelserve_db

