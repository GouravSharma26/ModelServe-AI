# Dockerfile for ModelServe AI Streamlit monitoring dashboard
FROM python:3.12-slim

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -g 10001 appuser && useradd -u 10001 -g appuser -m -s /bin/bash appuser

WORKDIR /app

# Install pinned Python dependencies
COPY requirements.lock /app/
RUN pip install --no-cache-dir -r requirements.lock

# Copy application source and project configuration
COPY pyproject.toml /app/
COPY src /app/src

RUN pip install --no-cache-dir --no-deps -e .

RUN chown -R appuser:appuser /app

USER appuser

EXPOSE 8501

HEALTHCHECK --interval=15s --timeout=3s --retries=3 \
    CMD curl -f http://localhost:8501/_stcore/health || exit 1

CMD ["streamlit", "run", "src/modelserve/dashboard.py", "--server.port", "8501", "--server.address", "0.0.0.0"]

